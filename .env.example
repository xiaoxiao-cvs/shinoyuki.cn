# ============================================
# 环境变量配置（部署前必须修改）
# ============================================

# Home Assistant 长期访问令牌
# 获取方式：HA 左下角头像 → 长期访问令牌 → 创建令牌
HOMEPAGE_VAR_HA_TOKEN=你的HA长期访问令牌

# 副服务器 IP（替换 services.yaml 中的占位符）
SECONDARY_SERVER_IP=192.168.1.100

# 洛杉矶 VPS IP（替换 services.yaml 中的占位符）
LA_VPS_IP=1.2.3.4
